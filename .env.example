MTG_API_QDRANT_HOST=qdrant
MTG_API_QDRANT_PORT=6333
MTG_API_CORS_ORIGINS=["http://localhost:3000"]
# Google Gemini writes the answers. Required.
MTG_API_GEMINI_API_KEY=
MTG_API_GEMINI_MODEL=gemini-3.5-flash
PUBLIC_API_URL=http://localhost:8000

# Evals (see README "Evals"). Never enable eval mode in production.
MTG_API_EVAL_MODE=false
# Judge for `make eval-full`: any OpenAI-compatible chat endpoint.
# Ollama: http://localhost:11434/v1 (API key ignored).
EVAL_JUDGE_BASE_URL=http://localhost:11434/v1
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_KEY=ollama
